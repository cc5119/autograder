/target
/.autograder-store

# Generated in place by running the examples (see README.md): `vendor`'s
# vendor dir + offline cargo config, `ci`'s overlaid driver crate + build
# output, and standalone `cargo test`/`cargo nextest run` runs against a
# reference solution or harness.
examples/*/vendor/
examples/*/.cargo/
examples/*/.vendor-manifest/
examples/*/*/target/
examples/*/*/Cargo.lock
