/target
/.autograder-store

# Generated in place by running the example (see examples/*/README.md):
# `prefetch`'s vendor dir + offline cargo config, and `ci`'s overlaid
# driver crate + build output in a student submission's own checkout.
examples/*/instructor/vendor/
examples/*/instructor/.cargo/
examples/*/instructor/.vendor-manifest/
examples/*/public/vendor/
examples/*/public/.cargo/
examples/*/public/.vendor-manifest/
examples/*/submissions/*/driver/
examples/*/submissions/*/target/
examples/*/submissions/*/.cargo/
examples/*/submissions/*/Cargo.lock
