name: autograde
on:
  push:
    branches: [main]        # default branch only
jobs:
  public-tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: |
          curl -fsSL https://github.com/your-org/autograder/releases/download/v0.1.0/autograder-x86_64-linux -o autograder
          echo "<pinned-sha256>  autograder" | sha256sum -c -   # verify before exec
          chmod +x autograder
      - run: command -v podman || (sudo apt-get update && sudo apt-get install -y podman)
      - run: ./autograder prefetch .
      - run: podman pull {base_image}
      - run: ./autograder ci
